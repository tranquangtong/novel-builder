# ============================================================
# The Last Miracle Studio — cấu hình máy chủ
# Sao chép thành .env.local (KHÔNG commit file chứa giá trị thật).
# Mọi biến dưới đây chỉ đọc ở máy chủ; không biến nào được đưa ra trình duyệt.
# ============================================================

# demo  = dữ liệu thử trên đĩa (.demo-data), không kết nối GitHub
# github = repo bản thảo private trên GitHub qua GitHub App
DATA_MODE=demo

# Khóa mã hóa cookie phiên đăng nhập, >= 32 ký tự ngẫu nhiên.
# Tạo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# URL công khai của ứng dụng (dùng cho OAuth callback). Bỏ trống khi chạy local.
APP_URL=

# ---------- Chế độ demo ----------
# Mã truy cập trang đăng nhập demo. Local mặc định "demo"; production BẮT BUỘC đặt.
DEMO_PASSCODE=
# Thư mục dữ liệu demo (mặc định .demo-data)
DEMO_DATA_DIR=

# ---------- Chế độ GitHub ----------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Private key (.pem) của GitHub App. Có thể dán nguyên khối với \n, hoặc base64 của file .pem:
#   base64 -w0 your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY=
# Lấy từ URL trang cài đặt app: https://github.com/settings/installations/<ID>
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_REPO_BRANCH=main

# Chỉ MỘT tài khoản GitHub được phép đăng nhập (bản đầu tiên).
ALLOWED_GITHUB_LOGIN=
# Khuyến nghị: ID số của tài khoản (không đổi khi đổi username). Xem https://api.github.com/users/<login>
ALLOWED_GITHUB_USER_ID=
