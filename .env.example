# ============================================================
# The Last Miracle Studio — biến lúc BUILD (đều là thông tin công khai)
# Trang là web tĩnh trên GitHub Pages: KHÔNG có secret nào ở đây.
# Token GitHub được tác giả dán trên trang Kết nối và chỉ nằm trong trình duyệt.
# ============================================================

# Đường dẫn gốc khi chạy ở https://<user>.github.io/<tên-repo>/ (workflow tự đặt = /<tên-repo>)
NEXT_PUBLIC_BASE_PATH=

# Repo bản thảo gợi ý sẵn trên trang Kết nối, ví dụ tranquangtong/the-last-miracle-manuscript
# (trên GitHub: Settings → Secrets and variables → Actions → Variables → MANUSCRIPT_REPO)
NEXT_PUBLIC_MANUSCRIPT_REPO=
